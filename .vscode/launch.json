{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug game (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Disable ASLR so breakpoints are reliable",
          "text": "set disable-randomization on",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: build (debug)"
    }
  ]
}
